[Unit]
Description=Household Webpage Flask application
After=network.target

[Service]
Type=simple
User=jmena
Group=jmena
WorkingDirectory=/home/jmena/Household_Webpage
EnvironmentFile=-/etc/default/household-webpage
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/jmena/Household_Webpage/.venv/bin/gunicorn --workers 1 --bind 0.0.0.0:8000 --access-logfile - --error-logfile - wsgi:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
PrivateTmp=true

[Install]
WantedBy=multi-user.target
